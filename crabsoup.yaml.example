# Crabsoup example configuration.
#
# Copy to `crabsoup.yaml` (the default path) and adjust to taste.
# Every field has a sensible default; omitted fields are filled in.

# The PCM bus: every source is resampled/converted to this spec before mixing.
stream:
  sample_rate: 44100
  channels: 2
  frames_per_buffer: 4096   # ~93 ms at 44100 Hz

# Crossfade and ducking behaviour.
mixer:
  crossfade_seconds: 3.0    # track-to-track overlap window
  fade_curve: 1.0           # 1.0 = linear, 2.0 = equal-ish power
  duck_seconds: 1.5         # fade time into/out of a live DJ

# Local media playback. Either `directory` (recursively scanned) and/or
# `files` may be given; results are merged and sorted.
playlist:
  directory: ./media
  # files:
  #   - /path/to/special.mp3
  loop_playlist: true
  shuffle: false

# Icecast broadcaster. Omitting this section runs in preview mode
# (decodes and mixes but does not broadcast).
output:
  host: localhost
  port: 8000
  mount: /crabsoup.mp3
  source_user: source
  source_password: hackme
  format: mp3             # mp3 | opus
  bitrate: 192000
  name: Crabsoup
  description: Crabsoup stream
  genre: Various
  reconnect_seconds: 5

# Live DJ harbor (Icecast source protocol). DJs PUT their stream to this
# mount and the playlist is ducked while they are live. Omitting this
# section disables the listener.
live:
  host: 0.0.0.0
  port: 8005
  mount: /live
  password: dj            # Basic auth: any username, this password
