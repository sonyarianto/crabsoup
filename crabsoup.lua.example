-- Crabsoup example script.
--
-- Copy to `crabsoup.lua` (the default path) and adjust to taste.
-- This is plain Lua with Liquidsoap-flavoured names; `{key = value}`
-- tables are how named options are passed.
--
-- Minimal per-format test scripts live in `examples/`
-- (`crabsoup.opus.lua`, `crabsoup.mp3.lua`, `crabsoup.preview.lua`).

-- The PCM bus: every source is resampled/converted to this spec before mixing.
set("sample_rate", 44100)
set("channels", 2)
set("frames_per_buffer", 4096)   -- ~93 ms at 44100 Hz

-- Crossfade and ducking behaviour.
set("crossfade_seconds", 3.0)    -- track-to-track overlap window
set("fade_curve", 1.0)           -- 1.0 = linear, 2.0 = equal-ish power
set("duck_seconds", 1.5)         -- fade time into/out of a live DJ

-- Local media playback: recursively scanned directory and/or explicit files.
pl = playlist({directory = "./media", shuffle = false, loop = true})

-- DSP effects chain (each wraps the previous stage):
--   stretch({ratio = 1.5}, src)     tempo change, pitch preserved
--   pitch({semitones = 7}, src)     key shift, duration preserved
--   echo(src, {delay = 0.25, ping = 0.5, feedback = 0.5,
--              delay2 = 0.5, ping2 = 0.25})   multi-tap echo
--   reverb(src, {ir = "./media/hall.wav", wet = 0.3, dry = 0.7})  convolution
--   eq(src, {bands = {{type = "lowpass", freq = 15000},
--                     {type = "peaking", freq = 1000, gain = 3, q = 1.0}}})
--   filter(src, {type = "highpass", freq = 80})   single-band biquad
--   stereo(src, {pan = -0.25, width = 1.4})  balance pan + mid-side width
--   stereo.pan(src, -0.25); stereo.widen(src, 1.4)   method forms
--   vocalremover(src, {strength = 1, crossover = 150})  karaoke centre-cancel
--   bpm("track.mp3") / key("track.mp3")   offline BPM & key detection
--   amplify(src, gain); compress(src, opts); normalize(src, opts);
--   replaygain(src);   -- see examples/crabsoup.dsp.lua for a full chain
-- pl = normalize(pl, {target = -13, attack = 3, release = 0.5})

-- External broadcast processor (Liquidsoap `pipe`): runs any outboard
-- raw-PCM command as a pipeline stage. A writer thread feeds the source to
-- the process's stdin, a reader thread decodes stdout back into the graph.
-- `process` is a full `sh -c` command; Stereo Tool uses `- -` for pipe
-- I/O, `-b 16` for s16 PCM (matching `format = "s16le"`), `-r` for the
-- bus sample rate, and `-q` to keep its progress output off stderr.
-- Deaths restart with backoff; while down the pipe bypasses to the raw
-- source, so audio never stops. `USE_ST` toggles the chain for A/B.
-- USE_ST = true
-- if USE_ST then
--     st = pipe({process = 'tools/stereo_tool/stereo_tool_cmd_64 -q -s '
--                       .. 'tools/stereo_tool/audio.sts '
--                       .. '-b 16 -r 44100 -k "<your-key>" - -',
--                format = "s16le"},
--               pl)
--     src = st
-- else
--     src = pl
-- end

-- One-shot jingles, playable from the telnet control port (`jingles.play`).
j = jingles({directory = "./jingles"})

-- Remote playlist without local files (e.g. a Deezer playlist served by a
-- sibling "Deezco" downloader daemon on localhost:9001): `http_get` is the
-- control-plane GET (synchronous, 16 MiB cap, raises on failure) and
-- `request.dynamic` asks for the next track lazily. The engine downloads
-- each `http(s)://` URL to a temp file, plays it, and deletes the file
-- when the track ends — so only the current track plus the prefetched
-- next one ever touch the disk, whatever the playlist size. Wrap the
-- recipe in `pcall` so a daemon hiccup returns nil (source drains) and
-- `fallback` can carry the show instead of killing the script:
--   deezco = "http://127.0.0.1:9001"
--   playlist_id = "1234567890"
--   function deezer_next()
--       local ok, t = pcall(function()
--           return json.parse(http_get(deezco .. "/playlists/" .. playlist_id .. "/next"))
--       end)
--       if not ok or t == nil or t.url == nil then
--           log("deezco: no track (" .. tostring(t) .. ")")
--           return nil
--       end
--       return "annotate:title=\"" .. t.title .. "\":" .. t.url
--   end
--   songs = request.dynamic(deezer_next)
-- Use it in place of the local `pl`:
--   jr = crossfade(rotate({songs, js}, {weights = {3, 1}}),
--                  {duration = 3.0})
--   output.icecast({host = ..., mount = "/crabsoup.opus", ...},
--                  fallback({live, jr}))

-- Automatic jingle rotation (the Liquidsoap `rotate` radio recipe):
-- every N tracks a jingle plays, forever, picked at random. The jingle
-- child loops and re-shuffles each cycle, so each pick is a fresh random
-- jingle. The rotate children must be *plain* playlists (no internal
-- crossfade — an internal fade would preload seconds ahead of the
-- scheduler and leak across the boundary), and one `crossfade` on top
-- fades every transition uniformly: song->song, song->jingle,
-- jingle->jingle. `weights = {3, 1}` means 3 songs, 1 jingle, strictly
-- alternating at track boundaries (Liquidsoap's rotate picks randomly
-- per track instead). Use the wrapped source in place of `pl` (and `j`):
--   songs = playlist({directory = "./media", crossfade = false})
--   js = playlist({directory = "./jingles", loop = true, shuffle = true,
--                  crossfade = false})
--   jr = crossfade(rotate({songs, js}, {weights = {3, 1}}),
--                  {duration = 3.0})
--   output.icecast({host = ..., mount = "/crabsoup.opus", ...},
--                  fallback({live, jr}))
-- Per-track followers (`annotated(src, {append = "jingles/x.mp3"})`) are
-- the fixed-jingle variant: the same track after every song, no rotation.

-- Live DJ harbor (Icecast source protocol): DJs PUT to this mount and the
-- playlist is ducked while they are live. The value composes as a marker.
-- `extra_passwords = {"alice", "bob"}` adds per-streamer (DJ) passwords
-- that all authenticate on the same mount alongside `password`; the control
-- port's `status` reports `live: true|false` while a DJ is on air.
live = input.harbor({host = "0.0.0.0", port = 8005,
                     mount = "/live", password = "dj"})

-- Telnet control port (jingles.list / jingles.play / shutdown / ...).
server.telnet({host = "127.0.0.1", port = 1234})

-- The broadcast: `format` is "mp3" or "opus". The first source argument is
-- the engine's root; `fallback({...})` switches to the first child that
-- still has audio.
output.icecast({host = "localhost", port = 8000,
                mount = "/crabsoup.opus", format = "opus", bitrate = 128000,
                source_user = "source", source_password = "hackme",
                name = "Crabsoup", description = "Crabsoup stream",
                genre = "Various", reconnect = 5},
               fallback({j, live, pl}))

-- SHOUTcast instead of Icecast: `protocol` is "shoutcast-v1" (MP3 only),
-- "shoutcast-v2" (alias "shoutcast"), or "icecast" (default). v2 also
-- accepts format = "aac" (HE-AAC / AAC+; DNAS 2.6.1 corrupts the AAC
-- listener relay, so MP3 is the reliable choice). Titles go out via the
-- admin.cgi updinfo endpoint; `source_user` is ignored; for v2, mount is
-- the stream path ("/" or "/stream/N"). On a v2 DNAS, v1 sources use
-- portbase + 1.
-- output.icecast({host = "radio.example.com", port = 8000, mount = "/",
--                 format = "mp3", bitrate = 128000, protocol = "shoutcast-v2",
--                 source_password = "changeme", name = "Crabsoup",
--                 genre = "Various", reconnect = 5},
--                fallback({j, live, pl}))

-- Decode + mix locally without broadcasting (instead of output.icecast):
-- output.preview(fallback({j, live, pl}))

-- HLS(video) instead of a broadcast (video build only:
-- `cargo build --release --features video`): the audio side of each file
-- flows through the normal audio graph, the video side rides its own
-- decode thread, and `output.hls` interleaves both into keyframe-aligned
-- MPEG-TS segments plus `index.m3u8` (master) / `playlist.m3u8` (media).
-- Keep the two lists over the same files, in the same order, for a/v sync.
-- vpl = video.playlist({directory = "./media/video", loop = true})
-- output.hls({directory = "/var/www/hls", video = vpl,
--             segment_seconds = 4, retention = 12},
--            fallback({j, live, pl}))

-- Slideshow variant: still images instead of a video playlist. Images are
-- decoded once at script evaluation and crossfade over transition_seconds.
-- -- ss = video.slideshow({directory = "./art", seconds_per_image = 5,
-- --                        transition = "fade", transition_seconds = 1})
-- -- output.hls({directory = "/var/www/hls", video = ss,
-- --             segment_seconds = 4, retention = 12},
-- --            fallback({j, live, pl}))

-- Effects wrap any video.* marker (Part H3): scale rescales to a target
-- size, fade dips to black over the first/last N seconds. Both return an
-- updated marker and compose, so the output encodes at the scaled size.
-- -- src = video.scale({width = 640, height = 360},
-- --                   video.fade({fade_in = 1, fade_out = 2},
-- --                              video.video("./media/video/clip.mp4")))
-- -- output.hls({directory = "/var/www/hls", video = src,
-- --             segment_seconds = 4, retention = 12},
-- --            fallback({j, live, pl}))

-- RTMP broadcast (rtmp build only: `cargo build --release --features rtmp`;
-- add `video` for h264+aac). Publishes FLV (raw AAC, optional H.264) to any
-- RTMP server, e.g. nginx-rtmp on localhost:1935. `url` is required; drop
-- `video = vpl` (and the vpl line) for audio-only.
-- -- vpl = video.playlist({directory = "./media/video", loop = true})
-- -- output.rtmp({url = "rtmp://localhost/live/stream", bitrate = 128000,
-- --              video = vpl},
-- --             fallback({j, live, pl}))

-- MP4 file recording (video build only: `cargo build --release --features
-- video`; drop `video = vpl` and the vpl line for audio-only). The file is
-- opened at script start and finalized with the moov trailer when the tap
-- ends or on shutdown, so it is always seekable.
-- -- vpl = video.playlist({directory = "./media/video", loop = true})
-- -- output.mp4({file = "/tmp/out.mp4", bitrate = 128000, video = vpl},
-- --            fallback({j, live, pl}))
